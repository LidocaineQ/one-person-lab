{
  "name": "@one-person-lab/cordis-abi",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "opl-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./framework": {
      "types": "./src/framework.ts",
      "opl-source": "./src/framework.ts",
      "default": "./dist/framework.js"
    },
    "./client-graph": {
      "types": "./src/client-graph.ts",
      "opl-source": "./src/client-graph.ts",
      "default": "./dist/client-graph.js"
    },
    "./json": {
      "types": "./src/json.ts",
      "opl-source": "./src/json.ts",
      "default": "./dist/json.js"
    }
  },
  "files": ["dist", "contracts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "license": "Apache-2.0"
}
