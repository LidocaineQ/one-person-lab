{
  "$id": "https://one-person-lab.dev/contracts/opl-framework/cordis-composition-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPL Cordis Composition Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_version", "version", "snapshot_id", "snapshot_digest", "framework", "binding", "plugins"],
  "properties": {
    "snapshot_version": { "const": "cordis-composition-snapshot.v1" },
    "version": { "const": "cordis-composition-snapshot.v1" },
    "snapshot_id": { "type": "string", "pattern": "^cordis:snapshot:sha256:[a-f0-9]{64}$" },
    "snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "integrity"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor_adapter_id", "executor_route"],
      "properties": {
        "executor_adapter_id": { "type": "string", "minLength": 1 },
        "executor_route": { "type": "string", "minLength": 1 },
        "child_composition_snapshot_refs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["snapshot_id", "snapshot_digest"],
            "properties": {
              "snapshot_id": { "type": "string", "pattern": "^cordis:snapshot:sha256:[a-f0-9]{64}$" },
              "snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "foundry_evidence_ref": { "type": ["string", "null"] },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "plugin": {
      "$ref": "https://one-person-lab.dev/contracts/opl-framework/cordis-plugin-descriptor.schema.json"
    }
  }
}
