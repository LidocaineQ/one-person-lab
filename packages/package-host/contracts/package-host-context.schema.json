{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-framework/package-host-context.schema.json",
  "title": "OPL Package Host Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "context_id",
    "context_digest",
    "package_id",
    "integration_kind",
    "integration_point",
    "profile_id",
    "status",
    "composition_snapshot_refs",
    "capabilities",
    "blockers",
    "composition_policy",
    "authority_boundary"
  ],
  "properties": {
    "surface_kind": { "const": "opl_package_host_context.v1" },
    "context_id": { "type": "string", "minLength": 1 },
    "context_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "package_id": { "type": "string", "minLength": 1 },
    "integration_kind": {
      "enum": [
        "standard_agent_runtime",
        "capability_provider",
        "host_client",
        "workflow_profile_source"
      ]
    },
    "integration_point": { "type": "string", "minLength": 1 },
    "profile_id": { "enum": ["base-headless", "app-full", "foundry-dev"] },
    "status": { "enum": ["ready", "degraded", "blocked"] },
    "composition_snapshot_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["composition_id", "snapshot_id", "snapshot_digest"],
        "properties": {
          "composition_id": { "type": "string", "minLength": 1 },
          "snapshot_id": { "type": "string", "minLength": 1 },
          "snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolution" }
        },
        "optional": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolution" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "composition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeze", "hot_swap", "teardown_owner"],
      "properties": {
        "freeze": {
          "enum": ["composition_start", "invocation_start", "attempt_start"]
        },
        "hot_swap": { "const": false },
        "teardown_owner": { "enum": ["opl_host", "package"] }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidden_authorities"],
      "properties": {
        "forbidden_authorities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "requested_api_versions",
        "requested_scope",
        "status",
        "provider"
      ],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "requested_api_versions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "uniqueItems": true
        },
        "requested_scope": {
          "enum": ["process", "composition", "session", "attempt", "request"]
        },
        "status": {
          "enum": ["resolved", "missing", "api_incompatible", "scope_incompatible"]
        },
        "provider": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "plugin_id",
                "plugin_api_version",
                "scope",
                "snapshot_id",
                "snapshot_digest",
                "disposer"
              ],
              "properties": {
                "plugin_id": { "type": "string", "minLength": 1 },
                "plugin_api_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
                "scope": {
                  "enum": ["process", "composition", "session", "attempt", "request"]
                },
                "snapshot_id": { "type": "string", "minLength": 1 },
                "snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "disposer": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["required", "boundary"],
                  "properties": {
                    "required": { "const": true },
                    "boundary": { "enum": ["plugin_fiber", "composition_context"] }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
