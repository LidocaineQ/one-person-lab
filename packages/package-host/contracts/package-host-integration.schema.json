{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-framework/package-host-integration.schema.json",
  "title": "OPL Package Host Integration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "integration_kind",
    "standalone_policy",
    "integration_points",
    "composition_policy",
    "authority_boundary"
  ],
  "properties": {
    "surface_kind": { "const": "opl_package_host_integration.v1" },
    "integration_kind": {
      "enum": [
        "standard_agent_runtime",
        "capability_provider",
        "remote_companion_connector",
        "host_client",
        "workflow_profile_source"
      ]
    },
    "standalone_policy": {
      "enum": ["forbidden", "allowed", "descriptor_only"]
    },
    "integration_points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/integrationPoint" }
    },
    "composition_policy": { "$ref": "#/$defs/compositionPolicy" },
    "channel_provider": { "$ref": "#/$defs/channelProvider" },
    "remote_companion_connector": { "$ref": "#/$defs/remoteCompanionConnector" },
    "authority_boundary": { "$ref": "#/$defs/authorityBoundary" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "api_versions", "scope"],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "api_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "scope": {
          "enum": ["process", "composition", "session", "attempt", "request"]
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityRequirement" }
        },
        "optional": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityRequirement" }
        }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_missing", "optional_missing"],
      "properties": {
        "required_missing": { "const": "reject_launch" },
        "optional_missing": { "const": "diagnostic_only" }
      }
    },
    "integrationPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_id",
        "trigger",
        "allowed_profiles",
        "requirements",
        "failure_policy"
      ],
      "properties": {
        "integration_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "trigger": {
          "enum": [
            "handler_ref",
            "stage_binding",
            "foundry_binding",
            "app_contribution",
            "channel_provider",
            "remote_companion_connector",
            "profile_materialization",
            "descriptor_discovery"
          ]
        },
        "allowed_profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["base-headless", "app-full", "foundry-dev"] },
          "uniqueItems": true
        },
        "requirements": { "$ref": "#/$defs/requirements" },
        "failure_policy": { "$ref": "#/$defs/failurePolicy" }
      }
    },
    "compositionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeze", "hot_swap", "teardown_owner"],
      "properties": {
        "freeze": {
          "enum": ["composition_start", "invocation_start", "attempt_start"]
        },
        "hot_swap": { "const": false },
        "teardown_owner": { "enum": ["opl_host", "package"] }
      }
    },
    "channelProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_service_id",
        "callback_api_version",
        "activation",
        "provider_source",
        "provider_identity",
        "thread_binding_fields",
        "thread_ref_fields",
        "turn_ref_field",
        "methods",
        "terminal_statuses",
        "subscription_lifecycle",
        "transport_boundary",
        "channel_access_controller",
        "channel_access_methods",
        "forbidden_surfaces"
      ],
      "properties": {
        "host_service_id": { "const": "opl.connect.channel-provider-host" },
        "callback_api_version": { "const": "1.0.0" },
        "activation": { "const": "optional_shell_injected" },
        "provider_source": { "const": "installed_descriptor_entrypoint" },
        "provider_identity": { "const": "manifest_package_id" },
        "thread_binding_fields": {
          "const": ["provider_id", "account_id", "channel_session_id"]
        },
        "thread_ref_fields": {
          "const": ["canonical_thread_host", "canonical_thread_id"]
        },
        "turn_ref_field": { "const": "canonical_turn_id" },
        "methods": {
          "const": ["startThread", "resumeThread", "startTurn", "subscribeTurn"]
        },
        "terminal_statuses": {
          "const": ["completed", "failed", "cancelled"]
        },
        "subscription_lifecycle": { "const": "disposable" },
        "transport_boundary": { "const": "current_shell_codex_app_server_only" },
        "channel_access_controller": { "const": "optional_descriptor_bound" },
        "channel_access_methods": {
          "const": ["readChannelAccess", "executeChannelAccessAction"]
        },
        "forbidden_surfaces": {
          "const": [
            "unrestricted_json_rpc",
            "second_app_server",
            "secret_persistence",
            "session_persistence",
            "thread_persistence"
          ]
        }
      }
    },
    "remoteCompanionConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_service_id",
        "callback_api_version",
        "activation",
        "connector_source",
        "connector_identity",
        "conversation_methods",
        "protected_blob_port",
        "protected_blob_max_bytes",
        "protected_blob_methods",
        "connector_factory",
        "connector_start_fields",
        "activation_context_fields",
        "remote_companion_access_controller",
        "remote_companion_access_methods",
        "forbidden_surfaces"
      ],
      "properties": {
        "host_service_id": { "const": "opl.connect.remote-companion-connector-host" },
        "callback_api_version": { "const": "1.0.0" },
        "activation": { "const": "optional_shell_injected" },
        "connector_source": { "const": "installed_descriptor_entrypoint" },
        "connector_identity": { "const": "manifest_package_id" },
        "conversation_methods": {
          "const": [
            "listDirectory",
            "readHistory",
            "startConversation",
            "openConversation",
            "sendMessage",
            "subscribeEvents",
            "stopTurn",
            "respondApproval",
            "refresh"
          ]
        },
        "protected_blob_port": { "const": "package_scoped_opaque_uint8array" },
        "protected_blob_max_bytes": { "const": 262144 },
        "protected_blob_methods": { "const": ["read", "replace", "clear"] },
        "connector_factory": { "const": "zero_argument_synchronous" },
        "connector_start_fields": {
          "const": [
            "activation_context",
            "canonical_conversation_bridge",
            "protected_blob"
          ]
        },
        "activation_context_fields": {
          "const": [
            "environment",
            "cohort_id",
            "protocol_version",
            "provider",
            "service_origin",
            "config_digest",
            "package_content_digest",
            "package_artifact_digest"
          ]
        },
        "remote_companion_access_controller": { "const": "optional_descriptor_bound" },
        "remote_companion_access_methods": {
          "const": [
            "readRemoteCompanionAccess",
            "executeRemoteCompanionAction"
          ]
        },
        "forbidden_surfaces": {
          "const": [
            "second_cordis_host",
            "second_app_server",
            "provider_history_as_conversation_truth",
            "conversation_history_persistence",
            "credential_material_persistence",
            "unrestricted_json_rpc"
          ]
        }
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidden_authorities"],
      "properties": {
        "forbidden_authorities": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
