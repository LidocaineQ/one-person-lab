{
  "contract_kind": "opl_source_structure_budget.v1",
  "surface_kind": "opl_source_structure_budget",
  "owner": "one-person-lab",
  "purpose": "Expose source-file size as an advisory maintenance inventory without turning line count into a correctness, readiness, merge, release, or completion gate.",
  "state": "active_contract",
  "machine_boundary": "This contract owns advisory line-count thresholds and reasonable-refactor selection guidance. Findings never block development or claim architectural correctness. Runtime authority, dependency legality, domain truth, data integrity, release readiness, and quality verdicts remain with their canonical owners.",
  "default_limit": 1000,
  "advisory_near_limit": 850,
  "reasonable_refactor_policy": {
    "mode": "line_budget_as_signal_not_splitter",
    "split_candidate": "source_or_test_file_at_or_above_default_limit_or_near_limit_with_observed_maintenance_risk",
    "near_limit_requires_additional_signals": [
      "high_churn",
      "long_function_or_complexity",
      "repeated_implementation",
      "import_cycle",
      "test_gap",
      "explicit_structure_rule"
    ],
    "preferred_split_boundaries": [
      "owner",
      "domain_concept",
      "lifecycle_phase",
      "runtime_surface",
      "action_route",
      "behavior_case",
      "test_scenario",
      "stable_helper",
      "contract_boundary",
      "existing_parts_or_cases_pattern"
    ],
    "merge_candidate": "small_shallow_single_caller_wrapper_without_clear_interface_value",
    "characterization_first": [
      "runtime_authority",
      "domain_truth",
      "release_authority",
      "public_package_export",
      "contract_generator",
      "cross_repo_boundary",
      "currentness_or_provider_semantics"
    ],
    "watch_only": "file_size_without_a_clear_maintenance_problem_or_safe_semantic_boundary",
    "completion_policy": "selected_batch_verified_or_no_safe_high_value_candidate"
  },
  "baseline_policy": {
    "mode": "advisory_inventory_only",
    "default_developer_behavior": "findings_exit_zero",
    "compatibility_entrypoints": [
      "scripts/line-budget.mjs --strict",
      "OPL_LINE_BUDGET_STRICT=1 node scripts/line-budget.mjs",
      "npm run line-budget:strict",
      "./scripts/verify.sh line-budget:strict",
      "./scripts/verify.sh structure:strict"
    ],
    "compatibility_behavior": "legacy_strict_names_are_advisory_aliases_and_never_turn_line_count_or_generic_quality_findings_into_blockers",
    "new_oversized_file": "advisory_refactor_candidate",
    "existing_oversized_file_growth": "advisory_refactor_candidate",
    "reviewed_baselines": "retired_no_per_file_line_lock_or_exception_ledger",
    "line_count_ledger_owner": "none"
  },
  "reviewed_baselines": []
}
