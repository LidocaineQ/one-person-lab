{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-framework/release-bundle-consumer-envelope.schema.json",
  "title": "OPL Release Bundle Consumer Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "schema_ref",
    "envelope_digest",
    "bundle_digest",
    "release",
    "cohort",
    "track",
    "operation",
    "checkpoint_stage",
    "source_checkpoint_run_id",
    "assets",
    "qualified",
    "published",
    "reconcile_required",
    "next_action",
    "latest_event_id",
    "evidence",
    "consumer_trigger_only",
    "consumer_may_dispatch",
    "recovery_command"
  ],
  "properties": {
    "surface_kind": { "const": "opl_release_bundle_consumer_envelope.v1" },
    "schema_ref": {
      "const": "contracts/opl-framework/release-bundle-consumer-envelope.schema.json"
    },
    "envelope_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bundle_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "version", "display_version", "updater_version", "tag"],
      "properties": {
        "channel": { "enum": ["stable", "nightly", "preview"] },
        "version": { "type": "string", "minLength": 1 },
        "display_version": { "type": "string", "minLength": 1 },
        "updater_version": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_source_commit", "shell_source_commit", "framework_source_commit"],
      "properties": {
        "app_source_commit": { "type": "string", "minLength": 1 },
        "shell_source_commit": { "type": "string", "minLength": 1 },
        "framework_source_commit": { "type": "string", "minLength": 1 }
      }
    },
    "track": { "enum": ["standard", "full"] },
    "operation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["operation_id", "operation_kind", "deadline_at"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "operation_kind": { "enum": ["standard", "append_full"] },
        "deadline_at": { "type": "string", "format": "date-time" }
      }
    },
    "checkpoint_stage": {
      "enum": [
        "frozen",
        "standard_built",
        "standard_qualified",
        "webui_built",
        "webui_qualified",
        "stable_built",
        "stable_qualified",
        "full_built",
        "full_qualified"
      ]
    },
    "source_checkpoint_run_id": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*$" },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size_bytes", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "qualified": { "type": "boolean" },
    "published": { "type": "boolean" },
    "reconcile_required": { "type": "boolean" },
    "next_action": {
      "enum": [
        "build",
        "verify",
        "publish",
        "reconcile",
        "checkpoint_export",
        "wait_for_distinct_operation",
        "consumer_readback",
        "none"
      ]
    },
    "latest_event_id": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "sha256"],
        "properties": {
          "kind": { "enum": ["operation_receipt", "bundle"] },
          "ref": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "consumer_trigger_only": { "const": true },
    "consumer_may_dispatch": { "const": false },
    "recovery_command": { "const": "opl release status then exact opl release reconcile" }
  }
}
