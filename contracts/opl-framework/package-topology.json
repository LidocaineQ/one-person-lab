    { "package_id": "@one-person-lab/package-host", "path": "packages/package-host", "package_kind": "cordis_contribution", "version_policy": "independent", "authority_owner": "opl-framework/package-platform", "contributions": ["package-host-plugin", "package-host-context"], "plugin_descriptor_sources": ["contracts/opl-package-host.json"] },
    { "package_id": "@one-person-lab/connect-discovery", "path": "packages/connect-discovery", "package_kind": "cordis_contribution", "version_policy": "independent", "authority_owner": "opl-framework/integration", "contributions": ["descriptor-discovery-plugin"], "plugin_descriptor_sources": ["src/index.ts"] },
