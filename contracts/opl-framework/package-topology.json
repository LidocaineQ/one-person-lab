{
  "$schema": "https://one-person-lab.dev/contracts/opl-framework/package-topology.schema.json",
  "version": "package-topology.v2",
  "root_package": "opl-framework",
  "packages": [
    {
      "package_id": "@one-person-lab/cordis-abi",
      "path": "packages/cordis-abi",
      "package_kind": "shared_abi",
      "version_policy": "independent",
      "authority_owner": "opl-framework/cordis-abi",
      "capability_domain_ids": [],
      "source_unit_refs": ["framework.host", "framework.kernel"],
      "plugin_ids": [],
      "contributions": [
        "plugin-descriptor",
        "composition-snapshot",
        "host-derived-client-graph"
      ],
      "plugin_descriptor_sources": []
    },
    {
      "package_id": "@one-person-lab/package-host",
      "path": "packages/package-host",
      "package_kind": "cordis_contribution",
      "version_policy": "independent",
      "authority_owner": "opl-framework/package-platform",
      "capability_domain_ids": ["package-platform"],
      "source_unit_refs": ["framework.authority.packages", "framework.host"],
      "plugin_ids": ["opl-cordis-package-host"],
      "contributions": [
        "package-host-plugin",
        "package-host-context"
      ],
      "plugin_descriptor_sources": [
        "contracts/opl-package-host.json"
      ]
    }
  ],
  "legacy_paths": {
    "paths": [
      "src/modules"
    ],
    "state": "retired",
    "must_be_absent": true,
    "caller_zero_required": true,
    "retirement_gate": "successor caller switched + focused/aggregate verification + source/package/contract readback"
  },
  "source_topology_ref": "contracts/opl-framework/source-module-map.json",
  "target_source_roots": [
    "src/authority",
    "src/adapters",
    "src/read-models",
    "src/host"
  ]
}
