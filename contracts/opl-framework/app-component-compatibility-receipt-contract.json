{
  "contract_kind": "opl_app_component_compatibility_receipt_contract.v1",
  "owner": "one-person-lab",
  "producer_role": "opl_framework",
  "state": "active_contract",
  "receipt_schema": "opl_component_compatibility_receipt.v1",
  "requirements_schema": "opl_component_compatibility_requirements.v1",
  "subject_schema": "opl_app_compatibility_subject.v1",
  "app_authority_ref": "contracts/app-install-exposure-policy.json#component_interoperability.compatibility_admission",
  "purpose": "Produce a short-lived Framework compatibility projection from App-owned capability, minimum-version, and SemVer-range requirements without creating cross-component version lockstep.",
  "semver_policy": {
    "implementation": "semver",
    "version_validation": "valid",
    "range_validation": "validRange",
    "range_evaluation": "satisfies",
    "include_prerelease": false,
    "invalid_version_or_range": "fail_closed_without_receipt",
    "supported_npm_semver_forms": [
      "prerelease_and_build_metadata",
      "hyphen_ranges",
      "partial_and_x_ranges",
      "comparator_sets",
      "or_ranges",
      "caret_ranges",
      "tilde_ranges"
    ]
  },
  "producer_observation": {
    "component_id": "opl_framework",
    "owner_authority": "one-person-lab",
    "version_source": "package.json#version",
    "generated_at_source": "producer_clock",
    "capabilities": [
      {
        "capability_id": "opl_app_state_projection",
        "schema_version": "1.0.0",
        "source_ref": "src/modules/console/app-state.ts"
      },
      {
        "capability_id": "opl_app_action_execution",
        "schema_version": "1.0.0",
        "source_ref": "src/modules/console/app-state-parts/action-execute.ts"
      },
      {
        "capability_id": "opl_dynamic_package_directory",
        "schema_version": "1.0.0",
        "source_ref": "src/modules/connect/agent-package-registry-parts/directory.ts"
      },
      {
        "capability_id": "opl_component_compatibility_receipt",
        "schema_version": "1.0.0",
        "source_ref": "src/modules/console/app-compatibility-receipt.ts"
      }
    ],
    "external_component_policy": "Requirements for components without a Framework-owner observation fail closed as unsatisfied; callers cannot inject observations into the producer."
  },
  "inputs": {
    "requirements": {
      "authority": "one-person-lab-app",
      "schema": "opl_component_compatibility_requirements.v1",
      "required_fields": [
        "schema",
        "owner",
        "contract_ref",
        "requirements"
      ],
      "requirements_must_be_non_empty": true,
      "allowed_requirement_kinds": [
        "capability_id_with_versioned_schema",
        "minimum_version",
        "semver_range"
      ],
      "capability_requirement_fields": [
        "requirement_id",
        "component_id",
        "kind",
        "capability_id",
        "schema_range"
      ],
      "version_requirement_fields": [
        "requirement_id",
        "component_id",
        "kind",
        "version_requirement"
      ]
    },
    "subject": {
      "authority": "one-person-lab-app",
      "schema": "opl_app_compatibility_subject.v1",
      "required_fields": [
        "schema",
        "owner",
        "selected_app_artifact",
        "installed_app_asar",
        "build_receipt"
      ],
      "selected_app_artifact_identity_fields": [
        "owner_authority",
        "immutable_release_tag",
        "asset_url",
        "asset_name",
        "byte_size",
        "sha256"
      ],
      "installed_app_asar_fields": [
        "path",
        "sha256"
      ],
      "build_receipt_fields": [
        "path",
        "sha256"
      ],
      "binding_role": "subject_and_evidence_only"
    }
  },
  "receipt": {
    "required_fields": [
      "schema",
      "owner",
      "producer_role",
      "contract_ref",
      "producer_contract_ref",
      "producer_identity",
      "receipt_ref",
      "generated_at",
      "issued_at",
      "expires_at",
      "freshness",
      "status",
      "sources",
      "subject",
      "requirements",
      "observed_components",
      "coverage",
      "failures",
      "authority_boundary"
    ],
    "status_values": [
      "compatible",
      "incompatible"
    ],
    "coverage_status_values": [
      "satisfied",
      "unsatisfied"
    ],
    "success_rule": "Every App-owned requirement has exactly one satisfied coverage entry and failures is empty.",
    "failure_rule": "Every unsatisfied requirement has exactly one allowed failure code and overall status is incompatible.",
    "producer_identity": {
      "command_surface": "opl app compatibility receipt",
      "framework_version_source": "package.json#version",
      "required_fields": [
        "command_surface",
        "executable_path",
        "executable_sha256",
        "framework_version",
        "package_ref"
      ],
      "executable_path_policy": "actual_producer_entrypoint_realpath",
      "executable_digest_policy": "sha256_of_actual_producer_entrypoint_bytes",
      "package_ref_policy": "realpath_bound_framework_package_root",
      "caller_must_match_executed_runtime": true,
      "self_declared_contract_ref_alone_is_authority": false
    },
    "output_binding": {
      "receipt_is_independent_json_file": true,
      "receipt_ref_is_absolute_file_ref": true,
      "sha256_sidecar_required": true,
      "receipt_sha256_returned_by_cli": true,
      "existing_output_must_not_be_overwritten": true
    }
  },
  "failure_policy": {
    "structural_fail_closed_without_receipt": [
      "requirements_missing_or_empty",
      "requirements_owner_schema_or_contract_ref_invalid",
      "subject_owner_or_schema_invalid",
      "installed_app_asar_missing_or_digest_drifted",
      "build_receipt_missing_or_digest_drifted",
      "producer_entrypoint_or_package_identity_invalid",
      "output_already_exists",
      "unsupported_semver_range"
    ],
    "compatibility_failure_codes": [
      "incompatible_missing_capability",
      "incompatible_capability_schema",
      "incompatible_minimum_version",
      "incompatible_semver_range"
    ],
    "consumer_fail_closed": [
      "receipt_missing",
      "receipt_schema_owner_or_producer_invalid",
      "receipt_expired",
      "coverage_incomplete",
      "receipt_digest_mismatch",
      "producer_identity_mismatch",
      "installed_app_asar_binding_drifted",
      "build_receipt_binding_drifted"
    ]
  },
  "authority_boundary": {
    "compatibility_only": true,
    "app_requirements_remain_app_owned": true,
    "framework_observations_and_verdict_remain_framework_owned": true,
    "selected_artifact_binding_is_subject_evidence_only": true,
    "exact_component_versions_or_digests_may_be_observational_provenance": true,
    "may_require_exact_cross_component_version_or_sha": false,
    "may_require_same_cohort": false,
    "may_define_package_currentness": false,
    "may_claim_release_ready": false,
    "may_claim_install_ready": false,
    "may_mutate_release_or_installed_state": false
  }
}
