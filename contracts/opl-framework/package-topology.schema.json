{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://one-person-lab.dev/contracts/opl-framework/package-topology.schema.json",
  "title": "OPL Framework package topology",
  "type": "object",
  "required": ["version", "root_package", "packages", "legacy_paths"],
  "properties": {
    "version": { "const": "package-topology.v1" },
    "root_package": { "const": "opl-framework" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["package_id", "path", "package_kind", "version_policy", "authority_owner", "contributions", "plugin_descriptor_sources"],
        "properties": {
          "package_id": { "type": "string", "pattern": "^@one-person-lab/[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^packages/[a-z0-9-]+$" },
          "package_kind": { "enum": ["shared_abi", "cordis_contribution"] },
          "version_policy": { "enum": ["root_locked", "independent" ] },
          "authority_owner": { "type": "string", "minLength": 1 },
          "contributions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
          "plugin_descriptor_sources": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(src|contracts)/[a-zA-Z0-9._/-]+\\.(ts|json)$" },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": { "properties": { "package_kind": { "const": "cordis_contribution" } } },
            "then": { "properties": { "plugin_descriptor_sources": { "minItems": 1 } } },
            "else": { "properties": { "plugin_descriptor_sources": { "maxItems": 0 } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "legacy_paths": {
      "type": "object",
      "required": ["physical_root", "caller_zero_required"],
      "properties": {
        "physical_root": { "const": "src/modules" },
        "caller_zero_required": { "const": true },
        "retirement_gate": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
