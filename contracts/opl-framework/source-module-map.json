{
  "version": "source-module-map.v3",
  "scope": "opl_framework_source_module_map",
  "owner": "OPL Framework",
  "purpose": "Canonical source responsibility topology. Brand modules remain cross-repository capability-domain metadata and do not define physical source roots.",
  "state": "active_contract",
  "machine_boundary": "This contract maps Framework source units, target roots, and retired roots. It does not make a brand label, Package, or Cordis contribution a physical source owner.",
  "source_root": "src",
  "physical_module_root": null,
  "capability_domain_registry_ref": "contracts/opl-framework/family-capability-domain-registry.json",
  "alignment_rules": [
    "Brand modules are capability-domain labels; they are not physical source roots, Packages, or Cordis plugin counts.",
    "Framework source is organized by responsibility units under authority, adapters, read-models, host, entrypoints, and kernel.",
    "Cross-unit imports use the target unit public entrypoint or an explicit host plugin leaf.",
    "src/modules is retired and must be absent; no compatibility barrel remains.",
    "Entrypoints wire public surfaces; kernel remains brand-neutral."
  ],
  "shared_kernel": [
    { "path": "src/entrypoints/cli.ts", "role": "CLI dispatcher for all command families.", "primary_source_unit_id": "framework.kernel" },
    { "path": "src/kernel/types.ts", "role": "Shared public type barrel.", "primary_source_unit_id": "framework.kernel" },
    { "path": "src/kernel/managed-runtime-contract.ts", "role": "Brand-neutral managed runtime contract normalization.", "primary_source_unit_id": "framework.kernel" },
    { "path": "src/kernel/local-codex-defaults.ts", "role": "Brand-neutral local Codex defaults reader.", "primary_source_unit_id": "framework.kernel" }
  ],
  "physical_layout": {
    "version": "source-topology-physical-layout.v2",
    "stage": "target",
    "target_cli_entrypoint": "src/entrypoints/cli.ts",
    "target_activation_path": "src/entrypoints/cli.ts",
    "legacy_roots": ["src/modules"],
    "root_ts_policy": {
      "target_top_level_ts_count": 0,
      "allowed_transition_exception_kinds": [],
      "allowed_transition_exceptions": []
    }
  },
  "target_roots": [
    { "root_id": "authority", "path": "src/authority", "layer_id": "authority", "source_globs": ["src/authority/**/*.ts"] },
    { "root_id": "adapters", "path": "src/adapters", "layer_id": "adapters", "source_globs": ["src/adapters/**/*.ts"] },
    { "root_id": "read_models", "path": "src/read-models", "layer_id": "read-models", "source_globs": ["src/read-models/**/*.ts"] },
    { "root_id": "host", "path": "src/host", "layer_id": "host", "source_globs": ["src/host/**/*.ts"] },
    { "root_id": "entrypoints", "path": "src/entrypoints", "layer_id": "entrypoints", "source_globs": ["src/entrypoints/**/*.ts"] },
    { "root_id": "kernel", "path": "src/kernel", "layer_id": "kernel", "source_globs": ["src/kernel/**/*.ts"] }
  ],
  "legacy_roots": [
    { "path": "src/modules", "state": "retired", "must_be_absent": true, "caller_zero_required": true }
  ],
  "source_units": [
    {
      "unit_id": "framework.authority.contracts", "layer_id": "authority", "responsibility_kind": "contracts",
      "physical_root": "src/authority/contracts", "public_entrypoints": ["src/authority/contracts/index.ts"],
      "source_globs": ["src/authority/contracts/**/*.ts"], "capability_domain_ids": ["policy"], "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.authority.workspace", "layer_id": "authority", "responsibility_kind": "workspace",
      "physical_root": "src/authority/workspace", "public_entrypoints": ["src/authority/workspace/index.ts"],
      "source_globs": ["src/authority/workspace/**/*.ts"], "capability_domain_ids": ["workspace"], "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.authority.packages", "layer_id": "authority", "responsibility_kind": "packages",
      "physical_root": "src/authority/packages", "public_entrypoints": ["src/authority/packages/index.ts"],
      "source_globs": ["src/authority/packages/**/*.ts"], "capability_domain_ids": ["package-platform"],
      "package_ids": ["opl-framework", "@one-person-lab/package-host"]
    },
    {
      "unit_id": "framework.authority.stages", "layer_id": "authority", "responsibility_kind": "stages",
      "physical_root": "src/authority/stages", "public_entrypoints": ["src/authority/stages/index.ts"],
      "source_globs": ["src/authority/stages/**/*.ts"], "capability_domain_ids": ["stage-policy"], "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.authority.evidence", "layer_id": "authority", "responsibility_kind": "evidence",
      "physical_root": "src/authority/evidence", "public_entrypoints": ["src/authority/evidence/index.ts"],
      "source_globs": ["src/authority/evidence/**/*.ts"], "capability_domain_ids": ["evidence"], "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.authority.evolution", "layer_id": "authority", "responsibility_kind": "evolution",
      "physical_root": "src/authority/evolution", "public_entrypoints": ["src/authority/evolution/index.ts"],
      "source_globs": ["src/authority/evolution/**/*.ts"], "capability_domain_ids": ["evolution"],
      "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.adapters.execution", "layer_id": "adapters", "responsibility_kind": "execution",
      "physical_root": "src/adapters/execution", "public_entrypoints": ["src/adapters/execution/index.ts"],
      "source_globs": ["src/adapters/execution/**/*.ts"], "capability_domain_ids": ["execution"],
      "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.adapters.integration", "layer_id": "adapters", "responsibility_kind": "integration",
      "physical_root": "src/adapters/integration", "public_entrypoints": ["src/adapters/integration/index.ts"],
      "source_globs": ["src/adapters/integration/**/*.ts"], "capability_domain_ids": ["integration"],
      "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.read-models.catalog", "layer_id": "read-models", "responsibility_kind": "catalog",
      "physical_root": "src/read-models/catalog", "public_entrypoints": ["src/read-models/catalog/index.ts"],
      "source_globs": ["src/read-models/catalog/**/*.ts"], "capability_domain_ids": ["catalog-discovery"],
      "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.read-models.operator", "layer_id": "read-models", "responsibility_kind": "operator",
      "physical_root": "src/read-models/operator", "public_entrypoints": ["src/read-models/operator/index.ts"],
      "source_globs": ["src/read-models/operator/**/*.ts"], "capability_domain_ids": ["experience"], "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.host", "layer_id": "host", "responsibility_kind": "composition",
      "physical_root": "src/host", "public_entrypoints": ["src/host/composition-profiles.ts", "src/host/plugins/*.ts"],
      "source_globs": ["src/host/**/*.ts"], "capability_domain_ids": [],
      "package_ids": ["opl-framework", "@one-person-lab/cordis-abi"]
    },
    {
      "unit_id": "framework.entrypoints", "layer_id": "entrypoints", "responsibility_kind": "entrypoints",
      "physical_root": "src/entrypoints", "public_entrypoints": ["src/entrypoints/cli.ts"],
      "source_globs": ["src/entrypoints/**/*.ts"], "capability_domain_ids": [], "package_ids": ["opl-framework"]
    },
    {
      "unit_id": "framework.kernel", "layer_id": "kernel", "responsibility_kind": "kernel",
      "physical_root": "src/kernel", "public_entrypoints": ["src/kernel/*.ts"],
      "source_globs": ["src/kernel/**/*.ts"], "capability_domain_ids": [],
      "package_ids": ["opl-framework", "@one-person-lab/cordis-abi"]
    }
  ]
}
