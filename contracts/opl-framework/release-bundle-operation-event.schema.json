{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-framework/release-bundle-operation-event.schema.json",
  "title": "OPL Release Bundle Operation Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "schema_ref",
    "event_id",
    "event_idempotency_key",
    "bundle_digest",
    "operation_id",
    "operation_kind",
    "operation",
    "track",
    "checkpoint_stage",
    "status",
    "next_action",
    "deadline_at",
    "recorded_at",
    "evidence"
  ],
  "properties": {
    "surface_kind": { "const": "opl_release_bundle_operation_event.v1" },
    "schema_ref": {
      "const": "contracts/opl-framework/release-bundle-operation-event.schema.json"
    },
    "event_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "event_idempotency_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bundle_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operation_id": { "type": ["string", "null"], "minLength": 1 },
    "operation_kind": {
      "type": ["string", "null"],
      "enum": ["standard", "append_full", null]
    },
    "operation": {
      "enum": [
        "freeze",
        "operation_admit",
        "build",
        "verify",
        "publish",
        "reconcile",
        "checkpoint_import"
      ]
    },
    "track": {
      "type": ["string", "null"],
      "enum": ["standard", "webui", "full", null]
    },
    "checkpoint_stage": {
      "enum": [
        "frozen",
        "standard_built",
        "standard_qualified",
        "webui_built",
        "webui_qualified",
        "stable_built",
        "stable_qualified",
        "full_built",
        "full_qualified"
      ]
    },
    "status": {
      "enum": [
        "frozen",
        "complete",
        "idempotent",
        "upload_required",
        "reconcile_only",
        "late_observation"
      ]
    },
    "next_action": {
      "enum": [
        "build",
        "verify",
        "publish",
        "reconcile",
        "checkpoint_export",
        "wait_for_distinct_operation",
        "consumer_readback",
        "none"
      ]
    },
    "deadline_at": { "type": ["string", "null"], "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "sha256"],
        "properties": {
          "kind": { "const": "operation_receipt" },
          "ref": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
