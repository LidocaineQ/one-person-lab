{
  "surface_kind": "opl_package_host_integration.v1",
  "integration_kind": "standard_agent_runtime",
  "standalone_policy": "allowed",
  "integration_points": [
    {
      "integration_id": "standard-agent.handler-ref",
      "trigger": "handler_ref",
      "allowed_profiles": ["base-headless", "app-full", "foundry-dev"],
      "requirements": {
        "required": [
          {
            "service_id": "opl.charter.contracts",
            "api_versions": ["1.0.0"],
            "scope": "process"
          },
          {
            "service_id": "opl.atlas.catalog",
            "api_versions": ["1.0.0"],
            "scope": "composition"
          }
        ],
        "optional": [
          {
            "service_id": "opl.workspace.locator",
            "api_versions": ["1.0.0"],
            "scope": "session"
          },
          {
            "service_id": "opl.connect.descriptor-discovery",
            "api_versions": ["1.0.0"],
            "scope": "composition"
          }
        ]
      },
      "failure_policy": {
        "required_missing": "reject_launch",
        "optional_missing": "diagnostic_only"
      }
    },
    {
      "integration_id": "standard-agent.stage-binding",
      "trigger": "stage_binding",
      "allowed_profiles": ["base-headless", "app-full", "foundry-dev"],
      "requirements": {
        "required": [
          {
            "service_id": "opl.stagecraft.context",
            "api_versions": ["1.0.0"],
            "scope": "composition"
          },
          {
            "service_id": "opl.pack.stage-binding",
            "api_versions": ["1.0.0"],
            "scope": "composition"
          },
          {
            "service_id": "opl.runway.attempt.executor",
            "api_versions": ["1.0.0"],
            "scope": "attempt"
          }
        ],
        "optional": [
          {
            "service_id": "opl.workspace.locator",
            "api_versions": ["1.0.0"],
            "scope": "session"
          },
          {
            "service_id": "opl.ledger.owner-delta-observer",
            "api_versions": ["1.0.0"],
            "scope": "session"
          }
        ]
      },
      "failure_policy": {
        "required_missing": "reject_launch",
        "optional_missing": "diagnostic_only"
      }
    },
    {
      "integration_id": "standard-agent.foundry-binding",
      "trigger": "foundry_binding",
      "allowed_profiles": ["base-headless", "app-full", "foundry-dev"],
      "requirements": {
        "required": [
          {
            "service_id": "opl.charter.contracts",
            "api_versions": ["1.0.0"],
            "scope": "process"
          },
          {
            "service_id": "opl.atlas.catalog",
            "api_versions": ["1.0.0"],
            "scope": "composition"
          }
        ],
        "optional": [
          {
            "service_id": "opl.foundry.provider-manifest",
            "api_versions": ["1.0.0"],
            "scope": "composition"
          },
          {
            "service_id": "opl.foundry.evaluation",
            "api_versions": ["1.0.0"],
            "scope": "composition"
          }
        ]
      },
      "failure_policy": {
        "required_missing": "reject_launch",
        "optional_missing": "diagnostic_only"
      }
    }
  ],
  "composition_policy": {
    "freeze": "invocation_start",
    "hot_swap": false,
    "teardown_owner": "opl_host"
  },
  "authority_boundary": {
    "forbidden_authorities": [
      "package_installed_truth",
      "package_currentness",
      "native_carrier_lifecycle",
      "temporal_workflow_history",
      "temporal_retry_replay",
      "workspace_file_bytes",
      "workspace_binding_registry",
      "ledger_evidence_persistence",
      "ledger_receipt_authority",
      "foundry_agent_version",
      "foundry_promotion_activation",
      "domain_truth",
      "domain_quality_verdict",
      "app_product_truth",
      "credential_material",
      "security_sandbox"
    ]
  }
}
