{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-framework/family-capability-domain-registry.schema.json",
  "title": "OPL family capability-domain registry",
  "type": "object",
  "required": ["version", "portfolio", "display_groups", "domains", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "family-capability-domain-registry.v2" },
    "portfolio": {
      "type": "object",
      "required": ["portfolio_id", "owner", "purpose", "state", "display_model", "cardinality_policy", "framework_projection_ref", "framework_source_topology_ref", "framework_package_topology_ref"],
      "properties": {
        "portfolio_id": { "const": "opl-family-capability-portfolio" },
        "owner": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "state": { "const": "active_contract" },
        "display_model": { "const": "journey_groups" },
        "cardinality_policy": { "const": "evidence_driven_not_fixed" },
        "framework_projection_ref": { "const": "contracts/opl-framework/brand-module-registry.json" },
        "framework_source_topology_ref": { "const": "contracts/opl-framework/source-module-map.json" },
        "framework_package_topology_ref": { "const": "contracts/opl-framework/package-topology.json" }
      },
      "additionalProperties": false
    },
    "display_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["group_id", "display_name", "order", "product_promise"],
        "properties": {
          "group_id": { "enum": ["foundation", "build", "run", "operate"] },
          "display_name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "product_promise": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain_id", "brand_name", "display", "name_assessment", "authority_surfaces", "package_units", "contributions"],
        "properties": {
          "domain_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "brand_name": { "type": "string", "pattern": "^OPL [A-Z][A-Za-z]+$" },
          "display": {
            "type": "object",
            "required": ["short_name", "group_id", "order", "tagline"],
            "properties": {
              "short_name": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
              "group_id": { "enum": ["foundation", "build", "run", "operate"] },
              "order": { "type": "integer", "minimum": 1 },
              "tagline": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "name_assessment": {
            "type": "object",
            "required": ["verdict", "rationale"],
            "properties": {
              "verdict": { "enum": ["keep", "simplified"] },
              "rationale": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "authority_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "package_units": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "contributions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["contribution_id", "host", "owner", "independent_release", "slot_or_service"],
              "properties": {
                "contribution_id": { "type": "string", "minLength": 1 },
                "host": { "enum": ["framework-host", "app-client", "cloud-service", "domain-repo"] },
                "owner": { "type": "string", "minLength": 1 },
                "independent_release": { "type": "boolean" },
                "slot_or_service": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "object",
      "required": ["portfolio_is_brand_ssot", "framework_registry_is_projection", "brand_tracks_real_capability_boundary", "brand_not_source_owner", "package_not_plugin", "host_client_graph", "profiles"],
      "properties": {
        "portfolio_is_brand_ssot": { "const": true },
        "framework_registry_is_projection": { "const": true },
        "brand_tracks_real_capability_boundary": { "const": true },
        "brand_not_source_owner": { "const": true },
        "package_not_plugin": { "const": true },
        "host_client_graph": { "const": "host_projected_allowlisted_client_graph" },
        "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
