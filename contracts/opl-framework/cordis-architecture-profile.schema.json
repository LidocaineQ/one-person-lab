{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-framework/cordis-architecture-profile.schema.json",
  "title": "OPL Cordis Architecture And Composition Profile",
  "type": "object",
  "required": [
    "version",
    "scope",
    "owner",
    "state",
    "machine_boundary",
    "source_refs",
    "architecture_layers",
    "authority_boundary",
    "source_to_target_mapping",
    "profiles",
    "cutover"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "cordis-architecture-profile.v1" },
    "scope": { "const": "opl_framework_cordis_architecture_profile" },
    "owner": { "const": "OPL Framework" },
    "state": { "const": "p5r_rebaseline_active" },
    "machine_boundary": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repo_ref" }
    },
    "architecture_layers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/architecture_layer" }
    },
    "authority_boundary": { "$ref": "#/$defs/authority_boundary" },
    "source_to_target_mapping": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/source_mapping" }
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/profile" }
    },
    "cutover": { "$ref": "#/$defs/cutover" }
  },
  "$defs": {
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(contracts|src|tests|scripts|docs|package\\.json)(/|$)"
    },
    "architecture_layer": {
      "type": "object",
      "required": ["layer_id", "sequence", "owner_question", "authority", "cordis_role"],
      "additionalProperties": false,
      "properties": {
        "layer_id": {
          "enum": ["authority_domain", "package", "cordis_plugin_contribution", "curated_composition_profile"]
        },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 4 },
        "owner_question": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "cordis_role": { "type": "string", "minLength": 1 }
      }
    },
    "authority_boundary": {
      "type": "object",
      "required": ["cordis_is_security_sandbox", "forbidden_authorities", "owners"],
      "additionalProperties": false,
      "properties": {
        "cordis_is_security_sandbox": { "const": false },
        "forbidden_authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "owners": {
          "type": "array",
          "minItems": 7,
          "items": { "$ref": "#/$defs/authority_owner" }
        }
      }
    },
    "authority_owner": {
      "type": "object",
      "required": ["authority_id", "owner", "owner_surface_refs", "cordis_role", "cordis_can_write"],
      "additionalProperties": false,
      "properties": {
        "authority_id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "owner_surface_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "cordis_role": { "type": "string", "minLength": 1 },
        "cordis_can_write": { "const": false }
      }
    },
    "source_mapping": {
      "type": "object",
      "required": [
        "source_module_id",
        "source_brand_name",
        "source_entrypoint",
        "authority_domain_id",
        "authority_owner",
        "module_disposition",
        "target_contributions",
        "authority_continues_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "source_module_id": { "type": "string", "minLength": 1 },
        "source_brand_name": { "type": "string", "minLength": 1 },
        "source_entrypoint": { "$ref": "#/$defs/repo_ref" },
        "authority_domain_id": { "type": "string", "minLength": 1 },
        "authority_owner": { "type": "string", "minLength": 1 },
        "module_disposition": { "enum": ["retain", "split", "merge", "demote"] },
        "target_contributions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contribution" }
        },
        "authority_continues_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repo_ref" }
        }
      }
    },
    "contribution": {
      "type": "object",
      "required": [
        "contribution_id",
        "plugin_id",
        "disposition",
        "implementation_state",
        "source_refs",
        "caller_refs",
        "scope",
        "trust",
        "authority_role",
        "forbidden_authorities",
        "allowed_profiles"
      ],
      "additionalProperties": false,
      "properties": {
        "contribution_id": { "type": "string", "minLength": 1 },
        "plugin_id": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["retain", "split", "merge", "demote"] },
        "implementation_state": { "enum": ["landed", "planned", "candidate"] },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "caller_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "scope": { "enum": ["process", "composition", "session", "attempt", "request"] },
        "trust": { "enum": ["first_party_privileged", "first_party_restricted", "third_party_untrusted"] },
        "authority_role": { "type": "string", "minLength": 1 },
        "forbidden_authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "profile_id",
        "status",
        "host",
        "default_candidate",
        "caller_refs",
        "plugin_allowlist",
        "composition_scope",
        "runtime_constraints",
        "authority_boundary"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "candidate", "active"] },
        "host": { "enum": ["headless", "app", "foundry_dev"] },
        "default_candidate": { "type": "boolean" },
        "caller_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repo_ref" }
        },
        "plugin_allowlist": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/profile_plugin" }
        },
        "composition_scope": { "enum": ["process", "session", "attempt"] },
        "runtime_constraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "authority_boundary": {
          "type": "object",
          "required": ["can_write_domain_truth", "can_write_package_currentness", "can_write_durable_history", "can_write_app_product_truth"],
          "additionalProperties": false,
          "properties": {
            "can_write_domain_truth": { "const": false },
            "can_write_package_currentness": { "const": false },
            "can_write_durable_history": { "const": false },
            "can_write_app_product_truth": { "const": false }
          }
        }
      }
    },
    "profile_plugin": {
      "type": "object",
      "required": ["plugin_id", "required", "reason"],
      "additionalProperties": false,
      "properties": {
        "plugin_id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "cutover": {
      "type": "object",
      "required": ["current_default_profile", "p5", "p6", "legacy_caller_zero_gate", "default_switch_gate", "retirement_rule"],
      "additionalProperties": false,
      "properties": {
        "current_default_profile": { "type": ["string", "null"] },
        "p5": { "$ref": "#/$defs/phase" },
        "p6": { "$ref": "#/$defs/phase" },
        "legacy_caller_zero_gate": { "$ref": "#/$defs/gate" },
        "default_switch_gate": { "$ref": "#/$defs/gate" },
        "retirement_rule": {
          "type": "object",
          "required": ["required_evidence", "permanent_dual_write_forbidden", "automatic_legacy_fallback_forbidden"],
          "additionalProperties": false,
          "properties": {
            "required_evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "permanent_dual_write_forbidden": { "const": true },
            "automatic_legacy_fallback_forbidden": { "const": true }
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "required": ["status", "required_outputs", "default_path_changed"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["active", "not_started", "landed"] },
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "default_path_changed": { "type": "boolean" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["required", "evidence", "owner_readback_required"],
      "additionalProperties": false,
      "properties": {
        "required": { "const": true },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "owner_readback_required": { "const": true }
      }
    }
  }
}
