{
  "$schema": "https://one-person-lab.dev/contracts/opl-framework/family-capability-domain-registry.schema.json",
  "version": "family-capability-domain-registry.v2",
  "portfolio": {
    "portfolio_id": "opl-family-capability-portfolio",
    "owner": "One Person Lab",
    "purpose": "Canonical product-language registry for the current OPL family capability brands and their real authority, Package, and Cordis contribution relationships.",
    "state": "active_contract",
    "display_model": "journey_groups",
    "cardinality_policy": "evidence_driven_not_fixed",
    "framework_projection_ref": "contracts/opl-framework/brand-module-registry.json",
    "framework_source_topology_ref": "contracts/opl-framework/source-module-map.json",
    "framework_package_topology_ref": "contracts/opl-framework/package-topology.json"
  },
  "display_groups": [
    {
      "group_id": "foundation",
      "display_name": "Foundation",
      "order": 1,
      "product_promise": "Set the rules and keep every job in the right place."
    },
    {
      "group_id": "build",
      "display_name": "Build",
      "order": 2,
      "product_promise": "Discover, package, and shape professional capabilities."
    },
    {
      "group_id": "run",
      "display_name": "Run",
      "order": 3,
      "product_promise": "Execute work, preserve evidence, and connect the ecosystem."
    },
    {
      "group_id": "operate",
      "display_name": "Operate",
      "order": 4,
      "product_promise": "See the system, improve it, and operate managed resources."
    }
  ],
  "domains": [
    {
      "domain_id": "policy",
      "brand_name": "OPL Charter",
      "display": { "short_name": "Charter", "group_id": "foundation", "order": 10, "tagline": "Set the boundaries." },
      "name_assessment": { "verdict": "keep", "rationale": "Short, distinctive, and accurately signals durable rules rather than runtime execution." },
      "authority_surfaces": ["one-person-lab/contracts", "one-person-lab-app/product-profile", "one-person-lab-cloud/policy"],
      "package_units": ["root-authority"],
      "contributions": [
        { "contribution_id": "framework-policy", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.charter.policy" }
      ]
    },
    {
      "domain_id": "workspace",
      "brand_name": "OPL Workspace",
      "display": { "short_name": "Workspace", "group_id": "foundation", "order": 20, "tagline": "Give work a place." },
      "name_assessment": { "verdict": "keep", "rationale": "Generic but immediately understood, established across local and cloud product surfaces, and tied to a real authority boundary." },
      "authority_surfaces": ["framework-workspace-registry", "workspace-file-carrier", "opl-cloud-workspace-service"],
      "package_units": ["root-authority"],
      "contributions": [
        { "contribution_id": "workspace-binding", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.workspace.locator" },
        { "contribution_id": "workspace-client-view", "host": "app-client", "owner": "opl-app", "independent_release": false, "slot_or_service": "workspace.sidebar" },
        { "contribution_id": "workspace-cloud-service", "host": "cloud-service", "owner": "opl-cloud", "independent_release": false, "slot_or_service": null }
      ]
    },
    {
      "domain_id": "catalog-discovery",
      "brand_name": "OPL Atlas",
      "display": { "short_name": "Atlas", "group_id": "build", "order": 30, "tagline": "Find every capability." },
      "name_assessment": { "verdict": "keep", "rationale": "A strong discovery metaphor that remains distinct from connection and execution." },
      "authority_surfaces": ["package-owner-descriptors", "domain-repo-manifests", "app-catalog-projection"],
      "package_units": ["root-authority"],
      "contributions": [
        { "contribution_id": "framework-catalog-read", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.atlas.catalog" },
        { "contribution_id": "client-agent-catalog", "host": "app-client", "owner": "opl-app", "independent_release": false, "slot_or_service": "agent.catalog" }
      ]
    },
    {
      "domain_id": "package-platform",
      "brand_name": "OPL Pack",
      "display": { "short_name": "Pack", "group_id": "build", "order": 40, "tagline": "Package the capability." },
      "name_assessment": { "verdict": "keep", "rationale": "Compact, memorable, and directly names the installable and describable capability boundary." },
      "authority_surfaces": ["package-descriptor", "package-abi", "native-carrier-currentness"],
      "package_units": ["package-host"],
      "contributions": [
        { "contribution_id": "package-host", "host": "framework-host", "owner": "opl-framework", "independent_release": true, "slot_or_service": "opl.pack.package-host" }
      ]
    },
    {
      "domain_id": "stage-policy",
      "brand_name": "OPL Stagecraft",
      "display": { "short_name": "Stagecraft", "group_id": "build", "order": 50, "tagline": "Shape the work." },
      "name_assessment": { "verdict": "keep", "rationale": "Distinctive and accurately describes deliberate stage and context design without claiming domain judgment." },
      "authority_surfaces": ["stage-contracts", "domain-quality-owner", "stage-run-projection"],
      "package_units": ["root-authority"],
      "contributions": [
        { "contribution_id": "stage-context", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.stagecraft.context" }
      ]
    },
    {
      "domain_id": "execution",
      "brand_name": "OPL Runway",
      "display": { "short_name": "Runway", "group_id": "run", "order": 60, "tagline": "Put work in motion." },
      "name_assessment": { "verdict": "keep", "rationale": "A clear execution metaphor with strong separation from stage design and evidence." },
      "authority_surfaces": ["temporal-history", "attempt-ledger", "executor-route"],
      "package_units": ["root-authority"],
      "contributions": [
        { "contribution_id": "executor-transport", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.runway.executor" }
      ]
    },
    {
      "domain_id": "evidence",
      "brand_name": "OPL Ledger",
      "display": { "short_name": "Ledger", "group_id": "run", "order": 70, "tagline": "Keep the evidence." },
      "name_assessment": { "verdict": "keep", "rationale": "Immediately communicates durable, inspectable evidence without implying ownership of artifact bodies or verdicts." },
      "authority_surfaces": ["ledger-receipts", "evidence-lineage", "refs-only-observation"],
      "package_units": ["root-authority"],
      "contributions": [
        { "contribution_id": "owner-delta-observer", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.ledger.owner-delta-observer" }
      ]
    },
    {
      "domain_id": "integration",
      "brand_name": "OPL Connect",
      "display": { "short_name": "Connect", "group_id": "run", "order": 80, "tagline": "Connect the ecosystem." },
      "name_assessment": { "verdict": "keep", "rationale": "Directly names external reach and carrier operations, which remain distinct from Atlas discovery." },
      "authority_surfaces": ["native-carrier", "provider-credentials", "source-discovery", "release-operation"],
      "package_units": ["root-authority"],
      "contributions": [
        { "contribution_id": "descriptor-discovery", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.connect.descriptor-discovery" },
        { "contribution_id": "client-connection", "host": "app-client", "owner": "opl-app", "independent_release": false, "slot_or_service": "connection.remote" }
      ]
    },
    {
      "domain_id": "experience",
      "brand_name": "OPL Console",
      "display": { "short_name": "Console", "group_id": "operate", "order": 90, "tagline": "See and act." },
      "name_assessment": { "verdict": "keep", "rationale": "Generic but familiar, and now grounded in real App, Cloud, and Framework projection surfaces." },
      "authority_surfaces": ["opl-cloud-console", "opl-app-product-profile", "framework-readiness-projection"],
      "package_units": ["root-authority", "app-client"],
      "contributions": [
        { "contribution_id": "framework-read-model", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.console.read-model" },
        { "contribution_id": "app-shell-client", "host": "app-client", "owner": "opl-app", "independent_release": false, "slot_or_service": "layout.root" },
        { "contribution_id": "cloud-console", "host": "cloud-service", "owner": "opl-cloud", "independent_release": false, "slot_or_service": null }
      ]
    },
    {
      "domain_id": "evolution",
      "brand_name": "OPL Foundry",
      "display": { "short_name": "Foundry", "group_id": "operate", "order": 100, "tagline": "Forge better agents." },
      "name_assessment": { "verdict": "simplified", "rationale": "Foundry already carries the making and evolution meaning; Kernel is retained only for an internal implementation role, not the public brand." },
      "authority_surfaces": ["agent-version", "evaluation-verdict", "activation-cas"],
      "package_units": ["root-authority"],
      "contributions": [
        { "contribution_id": "evaluation-adapter", "host": "framework-host", "owner": "opl-framework", "independent_release": false, "slot_or_service": "opl.foundry.evaluation" }
      ]
    },
    {
      "domain_id": "cloud-resource",
      "brand_name": "OPL Fabric",
      "display": { "short_name": "Fabric", "group_id": "operate", "order": 110, "tagline": "Operate managed resources." },
      "name_assessment": { "verdict": "keep", "rationale": "A strong infrastructure metaphor backed by a distinct Cloud resource authority and lifecycle." },
      "authority_surfaces": ["one-person-lab-cloud/services/fabric", "provider-operation-store", "resource-readback"],
      "package_units": ["cloud-service"],
      "contributions": [
        { "contribution_id": "fabric-provider", "host": "cloud-service", "owner": "opl-cloud", "independent_release": false, "slot_or_service": null }
      ]
    }
  ],
  "rules": {
    "portfolio_is_brand_ssot": true,
    "framework_registry_is_projection": true,
    "brand_tracks_real_capability_boundary": true,
    "brand_not_source_owner": true,
    "package_not_plugin": true,
    "host_client_graph": "host_projected_allowlisted_client_graph",
    "profiles": ["base-headless", "app-full", "research", "grant", "visual", "foundry-dev"]
  }
}
