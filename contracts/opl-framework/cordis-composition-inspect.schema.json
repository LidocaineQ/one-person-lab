{
  "$id": "https://one-person-lab.dev/contracts/opl-framework/cordis-composition-inspect.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPL Cordis Composition Inspect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "surface_kind",
    "schema_ref",
    "authority_boundary",
    "side_effects",
    "observation",
    "composition",
    "plugins",
    "diagnostics"
  ],
  "properties": {
    "version": { "const": "cordis-composition-inspect.v1" },
    "surface_kind": { "const": "opl_cordis_composition_inspect" },
    "schema_ref": { "const": "contracts/opl-framework/cordis-composition-inspect.schema.json" },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed_truth",
        "currentness_truth",
        "domain_truth",
        "readiness_truth",
        "lifecycle_authority",
        "mutation_authority"
      ],
      "properties": {
        "installed_truth": { "const": false },
        "currentness_truth": { "const": false },
        "domain_truth": { "const": false },
        "readiness_truth": { "const": false },
        "lifecycle_authority": { "const": false },
        "mutation_authority": { "const": false }
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_writes", "persistent_writes", "installed_truth_mutated"],
      "properties": {
        "external_writes": { "const": false },
        "persistent_writes": { "const": false },
        "installed_truth_mutated": { "const": false }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "state", "teardown_status"],
      "properties": {
        "scope": { "enum": ["isolated_experiment_command", "active_default_profile"] },
        "state": { "const": "active_context_observation" },
        "teardown_status": { "enum": ["caller_managed", "disposed_after_observation"] }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_version", "framework", "binding", "default_caller_activated", "plugin_runtime_count"],
      "properties": {
        "snapshot_version": { "type": "string", "minLength": 1 },
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version"],
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "binding": { "type": "object" },
        "default_caller_activated": { "type": "boolean" },
        "plugin_runtime_count": { "type": "integer", "minimum": 0 }
      }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "plugin_id", "diagnostic_ref"],
        "properties": {
          "code": { "enum": ["unknown_plugin_metadata", "required_plugin_not_loaded", "optional_plugin_not_loaded"] },
          "plugin_id": { "type": "string", "minLength": 1 },
          "diagnostic_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["emit", "parallel", "serial", "bail", "waterfall", "observe"] },
        "role": { "enum": ["publish", "observe"] }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source_ref",
        "metadata_status",
        "required",
        "provides",
        "injects",
        "state",
        "scope",
        "trust",
        "events",
        "fiber_count",
        "disposer_status",
        "diagnostic_refs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] },
        "metadata_status": { "enum": ["complete", "unknown"] },
        "required": { "type": ["boolean", "null"] },
        "provides": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        },
        "injects": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        },
        "state": { "enum": ["active", "pending", "loading", "failed", "unloading", "disposed", "not_loaded", "mixed", "unknown"] },
        "scope": { "type": "string", "minLength": 1 },
        "trust": { "type": "string", "minLength": 1 },
        "events": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/event" }
        },
        "fiber_count": { "type": "integer", "minimum": 0 },
        "disposer_status": { "enum": ["registered_at_observation", "not_registered", "disposed", "unknown"] },
        "diagnostic_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
