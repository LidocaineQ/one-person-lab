{
  "$id": "https://one-person-lab.dev/contracts/opl-framework/cordis-plugin-descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPL Cordis Plugin Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_version",
    "id",
    "plugin_id",
    "plugin_ref",
    "plugin_api_version",
    "source_ref",
    "source_commit",
    "source_identity",
    "package_ref",
    "required",
    "provides",
    "injects",
    "events",
    "scope",
    "trust",
    "disposer",
    "authority_boundary"
  ],
  "properties": {
    "descriptor_version": { "const": "cordis-plugin-descriptor.v1" },
    "id": { "type": "string", "minLength": 1 },
    "plugin_id": { "type": "string", "minLength": 1 },
    "plugin_ref": { "type": "string", "minLength": 1 },
    "plugin_api_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_ref": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "minLength": 1 },
    "source_identity": { "type": "string", "minLength": 1 },
    "package_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["package_id", "package_version", "package_ref"],
      "properties": {
        "package_id": { "type": "string", "minLength": 1 },
        "package_version": { "type": "string", "minLength": 1 },
        "package_ref": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "content_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "required": { "type": "boolean" },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "injects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/injection" }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/injection" }
        }
      }
    },
    "events": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/event" }
    },
    "scope": { "enum": ["composition", "attempt", "request"] },
    "trust": { "enum": ["first_party_privileged", "first_party_restricted", "third_party_untrusted"] },
    "disposer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "boundary"],
      "properties": {
        "required": { "const": true },
        "boundary": { "enum": ["plugin_fiber", "composition_context"] }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidden_authorities"],
      "properties": {
        "forbidden_authorities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "plugin_api_versions"],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "plugin_api_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["emit", "parallel", "serial", "bail", "waterfall", "observe"] },
        "role": { "enum": ["publish", "observe"] },
        "payload_schema_ref": { "type": ["string", "null"] }
      }
    }
  }
}
