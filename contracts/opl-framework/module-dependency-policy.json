{
  "version": "module-dependency-policy.v2",
  "scope": "opl_framework_module_dependency_policy",
  "owner": "OPL Framework",
  "purpose": "Machine-readable dependency policy for responsibility units under the OPL Framework source topology.",
  "state": "active_contract",
  "machine_boundary": "This contract governs physical source-module imports only. It does not define runtime truth, domain truth, owner receipts, typed blockers, release readiness, product packaging, or a new Framework module.",
  "source_module_map": "contracts/opl-framework/source-module-map.json",
  "module_set_policy": {
    "target_source_roots": [
      "src/authority",
      "src/adapters",
      "src/read-models",
      "src/host",
      "src/entrypoints",
      "src/kernel"
    ],
    "legacy_source_roots": [
      "src/modules"
    ],
    "legacy_absence_required": true,
    "new_unit_requires_source_map_update": true
  },
  "public_entrypoint_rule": {
    "cross_unit_imports": "public_entrypoint_or_host_plugin_leaf",
    "same_unit_deep_imports": "allowed",
    "host_plugin_leaf_pattern": "src/host/plugins/*.ts"
  },
  "source_scan_scope": {
    "checker_scope": "all_target_source_units",
    "included": [
      "src/authority/**/*.ts",
      "src/adapters/**/*.ts",
      "src/read-models/**/*.ts",
      "src/host/**/*.ts",
      "src/entrypoints/**/*.ts",
      "src/kernel/**/*.ts"
    ],
    "excluded": [
      "node_modules",
      "dist"
    ]
  },
  "completion_audit_policy": {
    "target_roots_required": [
      "src/authority",
      "src/adapters",
      "src/read-models",
      "src/host",
      "src/entrypoints",
      "src/kernel"
    ],
    "legacy_roots_absent": [
      "src/modules"
    ],
    "deep_imports_zero": true,
    "dependency_cycles_zero": true
  },
  "dependency_policy": {
    "layer_dependencies": [
      {
        "from_layer_id": "kernel",
        "to_layer_ids": [
          "kernel"
        ]
      },
      {
        "from_layer_id": "authority",
        "to_layer_ids": [
          "kernel",
          "authority"
        ]
      },
      {
        "from_layer_id": "adapters",
        "to_layer_ids": [
          "kernel",
          "authority",
          "adapters"
        ]
      },
      {
        "from_layer_id": "read-models",
        "to_layer_ids": [
          "kernel",
          "authority",
          "adapters",
          "read-models"
        ]
      },
      {
        "from_layer_id": "host",
        "to_layer_ids": [
          "kernel",
          "authority",
          "adapters",
          "read-models",
          "host"
        ]
      },
      {
        "from_layer_id": "entrypoints",
        "to_layer_ids": [
          "kernel",
          "host",
          "authority",
          "adapters",
          "read-models"
        ]
      }
    ],
    "forbidden_dependencies": []
  },
  "authority_boundary": {
    "does_not_create_eleventh_module": true,
    "does_not_move_domain_truth": true,
    "does_not_authorize_runtime_or_release_readiness": true
  }
}
