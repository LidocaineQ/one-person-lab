{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-framework/cordis-surface-map.schema.json",
  "title": "OPL Cordis Candidate Surface Map",
  "type": "object",
  "required": [
    "version",
    "scope",
    "owner",
    "state",
    "machine_boundary",
    "evidence_refs",
    "phase_state",
    "authority_boundary",
    "global_forbidden_authorities",
    "modules"
  ],
  "properties": {
    "version": {
      "const": "cordis-surface-map.v1"
    },
    "scope": {
      "const": "opl_framework_cordis_candidate_surface_map"
    },
    "owner": {
      "const": "OPL Framework"
    },
    "state": {
      "const": "p1_candidate_inventory"
    },
    "machine_boundary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repo_ref"
      }
    },
    "phase_state": {
      "type": "object",
      "required": [
        "cordis_adopted",
        "cordis_runtime_dependency_added",
        "default_caller_changed",
        "production_path_changed",
        "composition_snapshot_approved"
      ],
      "properties": {
        "cordis_adopted": {
          "const": false
        },
        "cordis_runtime_dependency_added": {
          "const": false
        },
        "default_caller_changed": {
          "const": false
        },
        "production_path_changed": {
          "const": false
        },
        "composition_snapshot_approved": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "authority_boundary": {
      "type": "object",
      "required": [
        "cordis_can_own_package_installed_truth",
        "cordis_can_own_package_currentness",
        "cordis_can_own_temporal_history_or_replay",
        "cordis_can_own_workspace_bytes_or_registry",
        "cordis_can_own_ledger_evidence_or_receipts",
        "cordis_can_own_foundry_versions_or_activation",
        "cordis_can_own_domain_truth_or_quality",
        "cordis_can_own_app_product_truth",
        "cordis_is_security_sandbox"
      ],
      "properties": {
        "cordis_can_own_package_installed_truth": {
          "const": false
        },
        "cordis_can_own_package_currentness": {
          "const": false
        },
        "cordis_can_own_temporal_history_or_replay": {
          "const": false
        },
        "cordis_can_own_workspace_bytes_or_registry": {
          "const": false
        },
        "cordis_can_own_ledger_evidence_or_receipts": {
          "const": false
        },
        "cordis_can_own_foundry_versions_or_activation": {
          "const": false
        },
        "cordis_can_own_domain_truth_or_quality": {
          "const": false
        },
        "cordis_can_own_app_product_truth": {
          "const": false
        },
        "cordis_is_security_sandbox": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "global_forbidden_authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/forbidden_authority"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/module_candidate"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "repo_ref": {
      "type": "string",
      "pattern": "^(contracts|src|tests)/.+"
    },
    "module_id": {
      "enum": [
        "charter",
        "atlas",
        "workspace",
        "pack",
        "stagecraft",
        "runway",
        "ledger",
        "console",
        "foundry",
        "connect"
      ]
    },
    "service_id": {
      "type": "string",
      "pattern": "^opl\\.[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^opl/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
    },
    "forbidden_authority": {
      "enum": [
        "package_installed_truth",
        "package_currentness",
        "native_carrier_lifecycle",
        "temporal_workflow_history",
        "temporal_retry_replay",
        "workspace_file_bytes",
        "workspace_binding_registry",
        "workspace_restore_delete_authority",
        "ledger_evidence_persistence",
        "ledger_receipt_authority",
        "foundry_agent_version",
        "foundry_promotion_activation",
        "domain_truth",
        "domain_quality_verdict",
        "app_product_truth",
        "credential_material",
        "security_sandbox"
      ]
    },
    "surface_evidence": {
      "type": "object",
      "required": [
        "symbol",
        "declaration_ref",
        "public_entrypoint_ref",
        "caller_refs"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "declaration_ref": {
          "$ref": "#/$defs/repo_ref"
        },
        "public_entrypoint_ref": {
          "$ref": "#/$defs/repo_ref"
        },
        "caller_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repo_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "provided_service": {
      "type": "object",
      "required": [
        "service_id",
        "service_kind",
        "existing_surface_symbol"
      ],
      "properties": {
        "service_id": {
          "$ref": "#/$defs/service_id"
        },
        "service_kind": {
          "enum": [
            "read_service",
            "policy_service",
            "compiler_service",
            "locator_service",
            "executor_service",
            "observer_service",
            "projection_service",
            "adapter_service"
          ]
        },
        "existing_surface_symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "injected_service": {
      "type": "object",
      "required": [
        "service_id",
        "requirement",
        "evidence_refs"
      ],
      "properties": {
        "service_id": {
          "$ref": "#/$defs/service_id"
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repo_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "event_candidate": {
      "type": "object",
      "required": [
        "event_id",
        "mode",
        "payload_owner",
        "payload_ref",
        "durability",
        "candidate_only"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "mode": {
          "enum": [
            "emit",
            "waterfall",
            "parallel",
            "serial"
          ]
        },
        "payload_owner": {
          "type": "string",
          "minLength": 1
        },
        "payload_ref": {
          "$ref": "#/$defs/repo_ref"
        },
        "durability": {
          "const": "in_process_only"
        },
        "candidate_only": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "authoritative_surface": {
      "type": "object",
      "required": [
        "authority_id",
        "owner",
        "evidence_refs"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repo_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "module_candidate": {
      "type": "object",
      "required": [
        "module_id",
        "brand_name",
        "module_owner",
        "public_entrypoint",
        "candidate_plugin_id",
        "candidate_disposition",
        "candidate_requirement",
        "lifecycle_state",
        "scopes",
        "trust_lane",
        "candidate_rationale",
        "surface_evidence",
        "provides",
        "injects",
        "events",
        "continue_authoritative_surfaces",
        "forbidden_authorities"
      ],
      "properties": {
        "module_id": {
          "$ref": "#/$defs/module_id"
        },
        "brand_name": {
          "type": "string",
          "minLength": 1
        },
        "module_owner": {
          "type": "string",
          "minLength": 1
        },
        "public_entrypoint": {
          "$ref": "#/$defs/repo_ref"
        },
        "candidate_plugin_id": {
          "type": "string",
          "pattern": "^opl\\.[a-z][a-z0-9-]*\\.candidate$"
        },
        "candidate_disposition": {
          "enum": [
            "p2_primary_experiment",
            "p2_supporting_experiment",
            "future_candidate_unapproved"
          ]
        },
        "candidate_requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "lifecycle_state": {
          "const": "not_implemented"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "process",
              "session",
              "attempt",
              "dev"
            ]
          }
        },
        "trust_lane": {
          "const": "trusted_first_party_candidate"
        },
        "candidate_rationale": {
          "type": "string",
          "minLength": 1
        },
        "surface_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surface_evidence"
          }
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provided_service"
          }
        },
        "injects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/injected_service"
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event_candidate"
          }
        },
        "continue_authoritative_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authoritative_surface"
          }
        },
        "forbidden_authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/forbidden_authority"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
